{
  "$comment": "fi-sdd-standard (ADR-0023, ADR-0028). Lo crea install.py y lo completa /project-context. Rutas y globs desde la raíz del repo, como .gitignore.",
  "protected": [],
  "secrets": [
    ".env",
    ".env.*",
    "**/appsettings.json",
    "**/appsettings.*.json",
    "**/secrets.json",
    "**/nuget.config",
    "**/nuget.*.config",
    "**/.npmrc",
    "**/*.pfx",
    "**/*.pem",
    "**/*.key"
  ],
  "secretsAllowed": [],
  "format": {},
  "formatTimeout": 60,
  "patterns": [],
  "$examples": {
    "protected": ["src/ClientApp/src/core-ui/**"],
    "secretsAllowed": ["src/Api/appsettings.json"],
    "format": {
      ".cs": ["dotnet", "csharpier", "format", "{file}"],
      ".tsx": [["npx", "eslint", "--fix", "{file}"], ["npx", "prettier", "--write", "{file}"]]
    },
    "patterns": [
      {"glob": "**/Controllers/*Controller.cs", "require": "\\[(Authorize|AuthorizeRoles|AllowAnonymous)", "message": "Todo controller declara su autorización ([Authorize] o [AllowAnonymous])"}
    ]
  }
}
